# ==========================================
# hello.chmp - example chimera v0.1 policy
# ==========================================

on_startup {

    echo("starting chimera")

    bind("/proc", "/chimera/rootfs/proc")
    bind("/sys", "/chimera/rootfs/sys")
    bind("/dev", "/chimera/rootfs/dev")
}


on_exit {

    echo("stopping chimera")

}


group filesystem {

    openat
    openat2
    read
    write
    close
    stat
    statx
    newfstatat
}


group process {

    clone
    fork
    execve
    exit
    wait4
}


group networking {

    socket
    connect
    bind
    listen
}


handle filesystem {

    path = get_arg(path)

    if regex(path, "^/chimera/rootfs") {
        allow
    }

    else {
        modify(path, map_path(root, path))
        allow
    }

}


handle networking {

    echo("network syscall")

    allow

}


syscall openat {

    path = get_arg(path)

    if regex(path, "/etc/passwd") {
        deny
    }

    modify(path, map_path(root, path))

    allow
}


syscall uname {

    echo("fake uname")

    modify(buffer, "Chimera Linux")

    allow
}
